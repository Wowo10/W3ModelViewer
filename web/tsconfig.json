{
	"compilerOptions": {
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable"],
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"types": []
